{
  "name": "invoice",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @invoice/web dev",
    "build": "bun run --filter @invoice/web build",
    "preview": "bun run --filter @invoice/web preview",
    "deploy": "bun run --filter @invoice/web deploy",
    "deploy:plan": "bun run --filter @invoice/web deploy:plan",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "test": "vitest run",
    "typecheck": "effect-tsgo patch && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.7",
    "@oxlint/plugins": "1.95.0",
    "@types/bun": "1.4.5",
    "dprint": "0.65.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
